{
  "_doc": "Component templates built from five primitives (frame, text, image, hit, stack). Rects are design px relative to the parent; strings like \"100%-6\" or \"50%-14\" scale with the instance size. {slot} fills from the instance's slots; if/unless test a slot (\"stamp\", \"kind=risk\"). runtime: true templates ship to Luau with slots intact (the kit fills them live); the rest are expanded into each screen. See references/kit.md.",
  "ticket": {
    "runtime": true,
    "size": [290, 64],
    "doc": "HUD notification ticket (ui.hud.anatomy): ink frame r11 3 px, paper card, 57 px kind stub, punch notches, perforation every 8 px, 40 px medallion, title, body, life bar, optional -8 deg stamp, merge badge.",
    "canon": ["ui.hud.ticket_size", "ui.hud.anatomy", "ui.hud.title_type", "ui.hud.body_type", "ui.hud.stamp", "ui.hud.life_bar", "ui.hud.crisis_extra"],
    "slots": {"kind": ["danger", "risk", "cash", "info"], "title": "text", "body": "text", "stamp": "text?", "icon": "asset", "count": "number?", "life": "0..1", "halo": "bool", "sticky": "bool"},
    "variants": {"compact": "ticket_compact"},
    "parts": [
      {"id": "mover", "type": "frame", "rect": [0, 0, 290, 64], "feel": "ticket", "children": [
        {"id": "halo_ink", "type": "frame", "if": "halo", "rect": [-7, -7, 304, 78], "fill": "ink", "radius": 17},
        {"id": "halo_red", "type": "frame", "if": "halo", "rect": [-4, -4, 298, 72], "fill": "danger", "alpha": 0.9, "radius": 14, "feel": "halo"},
        {"id": "shadow", "type": "frame", "rect": [0, 4, 290, 64], "fill": "shadow", "alpha": 0.45, "radius": 11},
        {"id": "frame", "type": "frame", "rect": [0, 0, 290, 64], "gradient": ["frame_top", "frame_bottom"], "stroke": ["ink", 3], "radius": 11, "clip": true, "children": [
          {"id": "card", "type": "frame", "rect": [3, 3, 284, 58], "gradient": ["paper_top", "paper_bottom"], "stroke": ["trim", 1.5], "radius": 8, "clip": true, "children": [
            {"id": "stub", "type": "frame", "rect": [0, 0, 54, 58], "gradient": ["kind.{kind}.top", "kind.{kind}.bottom"]},
            {"id": "stripes", "type": "frame", "if": "kind=risk", "rect": [0, 0, 54, 58], "pattern": "hazard"},
            {"id": "medallion", "type": "frame", "rect": [7, 9, 40, 40], "fill": "ink", "radius": "circle", "children": [
              {"id": "ring", "type": "frame", "rect": [2, 2, 36, 36], "gradient": ["trim_light", "trim_dark"], "radius": "circle", "children": [
                {"id": "disc", "type": "frame", "rect": [3, 3, 30, 30], "fill": "paper_top", "radius": "circle", "children": [
                  {"id": "icon", "type": "image", "rect": [4, 4, 22, 22], "image": "icon.{icon}", "tint": "ink"}
                ]}
              ]}
            ]},
            {"id": "title", "type": "text", "unless": "stamp", "rect": [62, 5, 206, 24], "text": "{title}", "style": "ticket_title", "color": "title", "truncate": true},
            {"id": "title_s", "type": "text", "if": "stamp", "rect": [62, 5, 131, 24], "text": "{title}", "style": "ticket_title", "color": "title", "truncate": true},
            {"id": "body", "type": "text", "rect": [62, 29, 206, 17], "text": "{body}", "style": "ticket_body", "color": "text", "truncate": true},
            {"id": "track", "type": "frame", "unless": "sticky", "rect": [62, 50, 206, 4], "fill": "ink", "alpha": 0.16, "radius": 2, "children": [
              {"id": "life", "type": "frame", "rect": [0, 0, 206, 4], "fill": "kind.{kind}.bar", "radius": 2, "bar": "life", "pin": "tl"}
            ]},
            {"id": "stamp", "type": "text", "if": "stamp", "rect": [204, 9, 68, 36], "rot": -8, "fill": "paper_top", "alpha": 0.9, "stroke": ["kind.{kind}.stamp", 2.5], "radius": 6, "text": "{stamp}", "style": "stamp", "color": "kind.{kind}.stamp", "align": "center", "feel": "stamp"}
          ]},
          {"id": "notch_top", "type": "frame", "rect": [49, -8, 16, 16], "fill": "ink", "radius": "circle"},
          {"id": "notch_bottom", "type": "frame", "rect": [49, 56, 16, 16], "fill": "ink", "radius": "circle"},
          {"id": "perf", "type": "frame", "rect": [55, 14, 4, 4], "fill": "ink", "alpha": 0.8, "radius": "circle", "repeat": {"n": 5, "dy": 8}}
        ]},
        {"id": "badge", "type": "text", "if": "count", "rect": [272, -10, 26, 26], "fill": "ink", "stroke": ["trim", 2], "radius": "circle", "text": "{count}", "style": "badge", "color": "trim_light", "align": "center", "feel": "badge"}
      ]}
    ]
  },
  "ticket_compact": {
