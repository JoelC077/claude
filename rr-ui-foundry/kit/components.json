    "size": [290, 44],
    "doc": "Older ticket (ui.hud.compact_rule): title + bar only, same stub, notches and medallion.",
    "canon": ["ui.hud.compact_rule", "ui.hud.ticket_size"],
    "slots": {"kind": ["danger", "risk", "cash", "info"], "title": "text", "icon": "asset", "count": "number?", "life": "0..1", "halo": "bool", "sticky": "bool"},
    "parts": [
      {"id": "mover", "type": "frame", "rect": [0, 0, 290, 44], "feel": "ticket", "children": [
        {"id": "halo_ink", "type": "frame", "if": "halo", "rect": [-7, -7, 304, 58], "fill": "ink", "radius": 17},
        {"id": "halo_red", "type": "frame", "if": "halo", "rect": [-4, -4, 298, 52], "fill": "danger", "alpha": 0.9, "radius": 14, "feel": "halo"},
        {"id": "shadow", "type": "frame", "rect": [0, 4, 290, 44], "fill": "shadow", "alpha": 0.45, "radius": 11},
        {"id": "frame", "type": "frame", "rect": [0, 0, 290, 44], "gradient": ["frame_top", "frame_bottom"], "stroke": ["ink", 3], "radius": 11, "clip": true, "children": [
          {"id": "card", "type": "frame", "rect": [3, 3, 284, 38], "gradient": ["paper_top", "paper_bottom"], "stroke": ["trim", 1.5], "radius": 8, "clip": true, "children": [
            {"id": "stub", "type": "frame", "rect": [0, 0, 54, 38], "gradient": ["kind.{kind}.top", "kind.{kind}.bottom"]},
            {"id": "stripes", "type": "frame", "if": "kind=risk", "rect": [0, 0, 54, 38], "pattern": "hazard"},
            {"id": "medallion", "type": "frame", "rect": [13, 5, 28, 28], "fill": "ink", "radius": "circle", "children": [
              {"id": "ring", "type": "frame", "rect": [2, 2, 24, 24], "gradient": ["trim_light", "trim_dark"], "radius": "circle", "children": [
                {"id": "disc", "type": "frame", "rect": [2, 2, 20, 20], "fill": "paper_top", "radius": "circle", "children": [
                  {"id": "icon", "type": "image", "rect": [3, 3, 14, 14], "image": "icon.{icon}", "tint": "ink"}
                ]}
              ]}
