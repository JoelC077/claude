{
  "_doc": "Semantic colour roles -> rr-bible token keys per skin, plus fonts, type styles, density and device frames. Specs and templates name roles, never hex. Skins A/B/C are the options of OQ-001; default_skin is used while it is open, and its decision (D-nnn) wins once made. See references/kit.md.",
  "default_skin": "C",
  "skin_oq": "OQ-001",
  "skins": {
    "A": "heritage brass (OQ-001 A, ui.hud_remake tokens)",
    "B": "teal-cream / mustard livery (OQ-001 B, prototype ui.hud_kinds tokens)",
    "C": "hybrid: in-world trim chrome, brand kind stubs (OQ-001 C, its default while open)"
  },
  "roles": {
    "ink":            {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "outlines, frames, notches, text on light"},
    "frame_top":      {"A": "ui.hud_remake.iron_top", "B": "style.brand.ink", "C": "style.world.ironwork", "use": "ticket frame gradient top"},
    "frame_bottom":   {"A": "ui.hud_remake.iron_bottom", "B": "style.brand.ink", "C": "style.world.soot_black", "use": "ticket frame gradient bottom"},
    "trim":           {"A": "ui.hud_remake.brass", "B": "style.brand.mustard", "C": "style.world.brass", "use": "pinline, rivets, panel rule"},
    "trim_light":     {"A": "ui.hud_remake.brass_light", "B": "style.brand.hazard_light", "C": "ui.hud_remake.brass_light", "use": "medallion ring top, badge text"},
    "trim_dark":      {"A": "ui.hud_remake.brass_dark", "B": "style.world.brass", "C": "ui.hud_remake.brass_dark", "use": "medallion ring bottom"},
    "paper_top":      {"A": "ui.hud_remake.card_top", "B": "ui.hud_kinds.paper_top", "C": "ui.hud_kinds.paper_top", "use": "card gradient top, medallion disc"},
    "paper_bottom":   {"A": "ui.hud_remake.card_bottom", "B": "ui.hud_kinds.paper_bottom", "C": "style.world.cream", "use": "card gradient bottom"},
    "title":          {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "titles on paper"},
    "text":           {"A": "ui.hud_remake.body", "B": "ui.hud_kinds.body_ink", "C": "ui.hud_kinds.body_ink", "use": "body text on paper and panels"},
    "panel":          {"A": "ui.hud_remake.card_top", "B": "ui.lobby.card", "C": "style.world.cream", "use": "panel body"},
    "header":         {"A": "ui.hud_remake.iron_top", "B": "ui.lobby.header", "C": "style.world.ironwork", "use": "panel header"},
    "on_header":      {"A": "ui.hud_remake.brass_light", "B": "style.brand.cream", "C": "style.brand.hazard_yellow", "use": "panel title"},
    "accent":         {"A": "ui.lobby.accent_brass", "B": "ui.lobby.accent_teal", "C": "style.world.brass", "use": "the one accent: selected, current, primary action (ui.rules.one_accent)"},
    "accent_dark":    {"A": "ui.hud_remake.brass_dark", "B": "style.brand.teal", "C": "ui.hud_remake.brass_dark", "use": "primary pressed face (ink label keeps >= 3:1; B was teal_dark 2.86:1, caught by the kit board)"},
    "on_accent":      {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "text on the accent"},
    "btn":            {"A": "ui.hud_remake.card_bottom", "B": "ui.hud_kinds.paper_bottom", "C": "ui.hud_kinds.paper_bottom", "use": "secondary button and chip face"},
    "btn_dark":       {"A": "ui.hud_remake.brass_dark", "B": "style.world.brass", "C": "style.world.brass", "use": "secondary pressed face"},
    "on_btn":         {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "text on secondary faces"},
    "shadow":         {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "drop shadows (with alpha)"},
    "focus":          {"A": "style.brand.hazard_yellow", "B": "style.brand.hazard_yellow", "C": "style.brand.hazard_yellow", "use": "gamepad focus ring (outer)"},
    "scrim":          {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "modal backdrop (with alpha)"},
    "danger":         {"A": "style.brand.danger_red", "B": "style.brand.danger_red", "C": "style.brand.danger_red", "use": "the one danger signal: crisis halo"},
    "hazard":         {"A": "style.brand.hazard_yellow", "B": "style.brand.hazard_yellow", "C": "style.brand.hazard_yellow", "use": "hazard stripes"},
    "hazard_ink":     {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink", "use": "hazard stripe ink"},
    "kind.danger.top":    {"A": "ui.hud_kinds.danger_stub_top", "B": "ui.hud_kinds.danger_stub_top", "C": "ui.hud_kinds.danger_stub_top"},
    "kind.danger.bottom": {"A": "ui.hud_remake.danger_stub_bottom", "B": "ui.hud_kinds.danger_stub_bottom", "C": "style.brand.danger_red"},
    "kind.danger.bar":    {"A": "ui.hud_kinds.danger_bar", "B": "ui.hud_kinds.danger_bar", "C": "ui.hud_kinds.danger_bar"},
    "kind.danger.stamp":  {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "kind.risk.top":      {"A": "ui.hud_kinds.risk_stripe", "B": "ui.hud_kinds.risk_stripe", "C": "style.brand.hazard_yellow"},
    "kind.risk.bottom":   {"A": "ui.hud_kinds.risk_stripe", "B": "ui.hud_kinds.risk_stripe", "C": "style.brand.hazard_yellow"},
    "kind.risk.bar":      {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "kind.risk.stamp":    {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "kind.cash.top":      {"A": "ui.hud_kinds.cash_stub_top", "B": "ui.hud_kinds.cash_stub_top", "C": "ui.hud_kinds.cash_stub_top", "note": "C keeps green, not mustard: mustard sits next to hazard yellow (risk)"},
    "kind.cash.bottom":   {"A": "ui.hud_remake.cash_stub_bottom", "B": "ui.hud_kinds.cash_stub_bottom", "C": "ui.hud_kinds.cash_stub_bottom"},
    "kind.cash.bar":      {"A": "ui.hud_kinds.cash_bar", "B": "ui.hud_kinds.cash_bar", "C": "ui.hud_kinds.cash_bar"},
    "kind.cash.stamp":    {"A": "ui.hud_kinds.cash_stamp", "B": "ui.hud_kinds.cash_stamp", "C": "ui.hud_kinds.cash_stamp"},
    "kind.info.top":      {"A": "ui.hud_kinds.info_stub_top", "B": "ui.hud_kinds.info_stub_top", "C": "style.brand.teal_bg_top"},
    "kind.info.bottom":   {"A": "ui.hud_remake.info_stub_bottom", "B": "ui.hud_kinds.info_stub_bottom", "C": "style.brand.teal"},
    "kind.info.bar":      {"A": "ui.hud_kinds.info_bar", "B": "ui.hud_kinds.info_bar", "C": "style.brand.teal_dark"},
    "kind.info.stamp":    {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "diff.easy":      {"A": "ui.difficulty.easy", "B": "ui.difficulty.easy", "C": "ui.difficulty.easy", "use": "difficulty colours only as difficulty (ui.rules.difficulty_never_chrome)"},
    "diff.medium":    {"A": "ui.difficulty.medium", "B": "ui.difficulty.medium", "C": "ui.difficulty.medium"},
    "diff.hard":      {"A": "ui.difficulty.hard", "B": "ui.difficulty.hard", "C": "ui.difficulty.hard"},
    "diff.insane":    {"A": "ui.difficulty.insane", "B": "ui.difficulty.insane", "C": "ui.difficulty.insane"},
    "on_diff.easy":   {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "on_diff.medium": {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "on_diff.hard":   {"A": "style.brand.ink", "B": "style.brand.ink", "C": "style.brand.ink"},
    "on_diff.insane": {"A": "style.brand.cream", "B": "style.brand.cream", "C": "style.brand.cream"}
  },
  "fonts": {"display": "style.type.display", "body": "style.type.body"},
  "type": {
    "ticket_title":   {"font": "display", "size": {"v": 20, "canon": "ui.hud.title_type"}, "line": 24},
    "ticket_title_c": {"font": "display", "size": 18, "line": 22, "note": "compact ticket (title + bar only)"},
    "ticket_body":    {"font": "body", "weight": 700, "size": {"v": 14, "canon": "ui.hud.body_type"}, "line": 17},
    "stamp":          {"font": "display", "size": {"v": 22, "canon": "ui.hud.stamp"}, "line": 26},
    "badge":          {"font": "display", "size": 18, "line": 20, "note": "count badge and +N MORE chip; 18 so a notched phone's own fit (0.94) stays >= ui.rules.min_text titles"},
    "title":          {"font": "display", "size": 26, "line": 30},
    "button":         {"font": "display", "size": 22, "line": 26},
    "button_cta":     {"font": "display", "size": 30, "line": 34, "note": "the one call to action: 1.5x the value style"},
    "chip":           {"font": "display", "size": 22, "line": 26},
    "value":          {"font": "display", "size": 20, "line": 24},
    "label":          {"font": "body", "weight": 800, "size": 14, "line": 17},
    "caption":        {"font": "body", "weight": 700, "size": 12, "line": 15}
  },
  "min_text": {"canon": "ui.rules.min_text", "parse": {"body": "body >= (\\d+)", "display": "titles >= (\\d+)"}},
  "focus": {"pad": 5, "outer": 3, "inner": 2, "radius_add": 5},
  "density": {
    "Small":  {"canon": "tech.ui_platform.layout", "parse": "UIScale ([\\d.]+) phone", "device": "phone"},
    "Medium": {"canon": "tech.ui_platform.layout", "parse": "([\\d.]+) PC", "device": "pc"},
    "Large":  {"oq": "OQ-033", "fit": 1.0}
  },
  "plate": {"about": "mock game plate behind boards (same tokens as rr-game-feel previews); not a game asset", "sky": "style.world.cream", "ground": "style.ground.pasture", "ballast": "style.ground.ballast", "rail": "style.ground.rail", "pole": "style.world.walnut", "cab": "style.world.navy", "bg": "ui.hud_kinds.kit_bg"},
  "devices": {
    "phone":       {"screen": "tech.ui_platform.phone", "insets": {"top": "tech.ui_platform.topbar_inset"}, "display": "Small", "input": "Touch", "design": true},
    "phone_notch": {"screen": "tech.ui_platform.phone", "insets": {"top": "tech.ui_platform.topbar_inset", "left": "tech.ui_platform.notch_inset", "right": "tech.ui_platform.notch_inset", "bottom": "tech.ui_platform.home_inset"}, "display": "Small", "input": "Touch"},
    "tablet":      {"screen": "tech.ui_platform.tablet", "insets": {"top": "tech.ui_platform.topbar_inset"}, "display": "Small", "input": "Touch"},
    "pc":          {"screen": "tech.ui_platform.pc", "insets": {"top": "tech.ui_platform.topbar_inset"}, "display": "Medium", "input": "KeyboardAndMouse"},
    "console":     {"screen": "tech.ui_platform.console", "insets": {"top": "tech.ui_platform.topbar_inset"}, "display": "Large", "input": "Gamepad"}
  },
  "zones": {
    "small_screen": "tech.ui_platform.touch_small_screen",
    "jump":  {"small": "tech.ui_platform.jump_zone_small", "large": "tech.ui_platform.jump_zone_large", "corner": "br"},
    "stick": {"small": "tech.ui_platform.stick_zone_small", "large": "tech.ui_platform.stick_zone_large", "corner": "bl"},
    "stick_area": "tech.ui_platform.stick_area",
    "touch_target": "tech.ui_platform.touch_target_px"
  }
}
