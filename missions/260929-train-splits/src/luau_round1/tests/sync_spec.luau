--[[
sync_spec.luau: rewrites every block the Luau kit embeds from src/kit/break_spec.json, so nothing is copied
by hand. Run from src/luau after the spec changes, then run the suite:
    lune run tests/sync_spec.luau && lune run tests/run_tests.luau
Blocks: the cells (RR_BreakChecker, RR_TrainSplit_Setup, TrainSplitConfig), the topple pivot and bodies
(TrainSplitConfig) and the spec version (both command-bar scripts, TrainSplitConfig, TrainSplitShared, TrainSplit).
]]

local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")

local here = debug.info(1, "s")
local luauDir = (here:match("^(.*)[/\\][^/\\]+$") or "."):match("^(.*)[/\\][^/\\]+$") or ".."
local srcDir = luauDir:match("^(.*)[/\\][^/\\]+$") or "../.."
local S = serde.decode("json", fs.readFile(srcDir .. "/kit/break_spec.json"))

-- Shortest text that reads back as the same number (-14.0, 0.25, 11.18).
local function num(v)
	if v == math.floor(v) and math.abs(v) < 1e15 then
		return ("%.1f"):format(v)
	end
	for p = 1, 17 do
		local s = ("%." .. p .. "g"):format(v)
		if tonumber(s) == v then
			return s
		end
	end
	return tostring(v)
end

local function cellLines(indent)
	local out = {}
	for _, c in S.cells do
		table.insert(out, ("%s{ %s, %s, %s, %s, %s, %q },"):format(indent, num(c.X[1]), num(c.X[2]), num(c.Y[1]), num(c.Y[2]), num(c.d), c.region))
	end
	return table.concat(out, "\n")
end

local function toppleLines()
	local t = S.topple
	local out = { ("Config.Pivot = { X_abs = %s, Y = %s } -- outer bogie edge at rail level on the falling side"):format(num(t.pivot.X_abs), num(t.pivot.Y)) }
	table.insert(out, "Config.Topple = {")
	for _, b in t.bodies do
		table.insert(out, "\t-- " .. b.who)
		table.insert(out, ("\t{ delay = %s, roll = %s, roll_time = %s, ease = %q, bounce = { %s, %s }, bounce_time = %s, yaw = %s, sink = %s },"):format(
			num(b.delay), num(b.roll), num(b.roll_time), b.ease, num(b.bounce[1]), num(b.bounce[2]), num(b.bounce_time), num(b.yaw), num(b.sink)))
	end
	table.insert(out, "}")
	return table.concat(out, "\n")
end

local changed = 0
local function rewrite(file, edits)
	local path = luauDir .. "/" .. file
	local src = fs.readFile(path)
	local before = src
	for _, e in edits do
		local n
		src, n = src:gsub(e[1], function(...)
			return e[2](...)
		end)
		if n ~= 1 then
			print("sync_spec: block not found once in " .. file .. " (" .. e[1] .. ")")
			process.exit(1)
		end
	end
	if src ~= before then
		fs.writeFile(path, src)
		changed += 1
		print("updated " .. file)
	end
end

local v = S.version
local cellsHeader = ("-- CELLS BEGIN (break_spec.json v%s) {X0, X1, Y0, Y1, d, region}: inside a cell the tear is at Z = d.\n"):format(v)
local coreCells = {
	"%-%- CELLS BEGIN[^\n]*\n(.-)local CELLS = {\n.-\n}\n%-%- CELLS END",
	function(comments)
		return cellsHeader .. comments .. "local CELLS = {\n" .. cellLines("\t") .. "\n}\n-- CELLS END"
	end,
}
local coreVersion = { 'local SPEC_VERSION = "[^"]*"', function()
	return ('local SPEC_VERSION = "%s"'):format(v)
end }

rewrite("RR_BreakChecker.lua", { coreCells, coreVersion })
rewrite("RR_TrainSplit_Setup.lua", { coreCells, coreVersion })
rewrite("TrainSplitConfig.lua", {
	{ "%-%- CELLS BEGIN[^\n]*\nConfig%.Cells = {\n.-\n}\n%-%- CELLS END", function()
		return ("-- CELLS BEGIN (break_spec.json v%s, %d cells; generated by tests/sync_spec.luau)\nConfig.Cells = {\n%s\n}\n-- CELLS END"):format(v, #S.cells, cellLines("\t"))
	end },
	{ "%-%- TOPPLE BEGIN[^\n]*\n.-%-%- TOPPLE END", function()
		return ("-- TOPPLE BEGIN (break_spec.json v%s; generated by tests/sync_spec.luau)\n%s\n-- TOPPLE END"):format(v, toppleLines())
	end },
	{ 'Config%.Version = "[^"]*"', function()
		return ('Config.Version = "%s"'):format(v)
	end },
})
rewrite("TrainSplitShared.lua", { { 'Shared%.Version = "[^"]*"', function()
	return ('Shared.Version = "%s"'):format(v)
end } })
rewrite("TrainSplit.lua", { { 'TrainSplit%.Version = "[^"]*"', function()
	return ('TrainSplit.Version = "%s"'):format(v)
end } })
print(("sync_spec: break_spec v%s, %d cells; %d file(s) changed"):format(v, #S.cells, changed))
