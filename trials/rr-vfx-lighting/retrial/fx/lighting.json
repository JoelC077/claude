  "Use2022Materials": {
   "v": false,
   "canon": "tech.lighting.materials_2022"
  },
  "canon_note": "tech.lighting.technology (Future) maps to LightingStyle Realistic + PrioritizeLightingQuality (tech.lighting.technology_api)"
 },
