{
 "version": 1,
 "about": "rr-vfx-lighting looks. A look is biome.time[+override]; it resolves base -> times[time] -> biomes[biome] -> overrides in order. Plain values set; {add}, {mul}, {lerp: [colour, t]} adjust. Light levels ([r,g,b] on Ambient, OutdoorAmbient, ColorShift_*, TintColor) are intensities, exempt from the palette gate but band-checked. Schema: references/presets.md.",
 "fx_colours": {
  "haze_grassland": {
   "hex": "#C2CAB0",
   "why": "canon asks a grey-green haze (tech.lighting.atmosphere); no token is a light grey-green"
  },
  "decay_day": {
   "hex": "#9FB0A8",
   "why": "zenith kept grey-green so the sky desaturates with the ground (style.material.sky), away from the blue-sky band"
  },
  "decay_golden": {
   "hex": "#93A6A2",
   "why": "cool zenith against the cream horizon keeps golden hour out of the sepia band (style.dont.dead_rails)"
  },
  "haze_dusk": {
   "hex": "#C4B6B4",
   "why": "dusk horizon: dusty rose-grey, warm enough to read as sunset, pink-leaning and low-saturation, away from the sepia band (style.dont.dead_rails)"
  },
  "decay_dusk": {
   "hex": "#7A5E6A",
   "why": "dusk zenith: mauve, so dusk has its own colour idea between day and night (critic pass-1 B4-1); not blue (style.dont.land_or_die)"
  }
 },
 "studio": {
  "about": "Studio-only settings, applied by studio_lighting_setup.lua in the command bar (not scriptable at runtime or set once per place)",
