  "custom_events": 100,
  "funnels": 10,
  "funnel_steps": 100,
  "skus": 100,
  "transaction_types": 20,
  "custom_fields": 3,
  "field_values": 8000,
  "source": "Roblox creator-docs production/analytics/event-types.md, fetched 2026-09-28"
 },
 "budgets": {
  "custom_events": 30,
  "fields_per_event": 3,
  "enum_values": 20,
  "skus": 40,
  "funnels": 5,
  "funnel_steps": 12,
  "max_per_min_default": 20
 },
 "onboarding": {
  "canon": "release.kpi.funnel",
  "question": "Where do first-time players drop before their first banked fare and first finished run?",
  "steps": [
   {
    "id": "join",
    "name": "Joined",
    "where": "lobby PlayerAdded, first session only (profile flag)"
   },
   {
    "id": "picked_up_tool",
    "name": "Picked up tool",
    "where": "server tool-equip handler (shovel, wrench, sandwich)"
   },
   {
    "id": "shovelled_coal",
    "name": "Shovelled coal",
    "where": "server firebox deposit handler"
   },
   {
    "id": "pulled_lever",
    "name": "Pulled lever",
    "where": "server lever commit (gameplay.fork.lock)"
   },
   {
    "id": "first_bank",
    "name": "First bank",
    "where": "server station payout (gameplay.station.bank)"
   },
   {
    "id": "run_end",
    "name": "Run end",
    "where": "server results start (arrive or fail)"
   }
  ]
 },
 "funnels": {
  "trip": {
   "question": "Which part of a trip loses crews: queue, boarding, first fork, first bank or arrival?",
   "session": "trip id made in the lobby and sent in TeleportData next to the canon UserIds (tech.data.teleport_data)",
   "steps": [
    {
     "id": "queued",
     "name": "Queued",
     "where": "lobby queue pad join"
    },
    {
     "id": "boarded",
     "name": "Boarded",
     "where": "trip place: player loaded on the train"
    },
    {
     "id": "departed",
     "name": "Departed",
     "where": "trip place: whistle / depart"
    },
    {
     "id": "first_fork",
     "name": "First fork",
     "where": "first junction resolved"
    },
    {
     "id": "first_bank",
     "name": "First bank",
     "where": "first station payout"
    },
    {
     "id": "arrived",
     "name": "Arrived",
     "where": "terminus arrival (not a fail)"
    }
   ]
  },
  "supply": {
   "question": "Does the Depotron order flow lose players between opening and fetching the crate?",
   "session": "one id per terminal open (HttpService:GenerateGUID(false))",
   "steps": [
    {
     "id": "opened",
     "name": "Terminal opened",
     "where": "ProximityPrompt triggered"
    },
    {
     "id": "ordered",
     "name": "Order placed",
     "where": "server accepted the order and took the coins"
    },
    {
     "id": "fetched",
     "name": "Crate fetched",
     "where": "crate picked up from the roof"
    }
   ]
  },
  "purchase": {
   "question": "Where do Robux purchases fail: prompt shown, accepted, or granted?",
   "session": "one id per prompt",
   "steps": [
    {
     "id": "prompt_shown",
     "name": "Prompt shown",
     "where": "server just before Prompt*Purchase"
    },
    {
     "id": "accepted",
     "name": "Accepted",
     "where": "PromptGamePassPurchaseFinished / PromptProductPurchaseFinished (isPurchased)"
    },
    {
     "id": "granted",
     "name": "Granted",
     "where": "after ProcessReceipt saved the grant (rr-exploit-guard pattern)"
    }
   ]
  }
 },
