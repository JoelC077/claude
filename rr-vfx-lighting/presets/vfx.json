{
 "version": 1,
 "about": "rr-vfx-lighting effect presets. Roblox property names, typed values; schema in references/presets.md. Colours: @bible.key tokens, $name from fx_colours, or #FFFFFF/#000000. Offsets and vectors are studs in the anchor's space (Y up, train forward +X). Generated Luau: vfx.py build.",
 "meta": {
  "wind_scale": 1.0,
  "speed_max": {"canon": "gameplay.speed.fast"},
  "speeds": {"slow": {"canon": "gameplay.speed.slow"}, "normal": {"canon": "gameplay.speed.normal"}, "fast": {"canon": "gameplay.speed.fast"}}
 },
 "fx_colours": {
  "steam_grey": {"hex": "#D9D8D2", "why": "steam tail as it thins; a light level of white steam, no palette grey is this light"},
  "rain_grey": {"hex": "#C3CACB", "why": "rain streaks; neutral cool grey kept out of the blue-sky band (cab glass #BFD9E6 sits in it)"}
 },
 "stand": {
  "about": "preview test stand only (not the game's geometry): anchors in Roblox studs, rail top y=0, train 165 long (tech.units.train_len), forward +X, right +Z",
