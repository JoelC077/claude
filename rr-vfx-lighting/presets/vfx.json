   "Chimney": [58, 17, 0],
   "SafetyValve": [40, 13.5, 0],
   "Boiler": [47, 13, 0],
   "Firebox": [31, 6, 0],
   "Headlamp": [67.5, 9, 0],
   "PowerBox": [-24, 7, 3.5],
   "WindowPane": [-50, 9, 4.6],
   "Axle": [-47, 1, 4.6],
   "Bogie": [-47, 1.5, 4.6],
   "RainBox": [-20, 60, 10]
  }
 },
